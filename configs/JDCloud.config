CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=n
# CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02="luci-app-athena-led luci-i18n-athena-led-zh-cn"

CONFIG_TESTING_KERNEL=y
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
# CONFIG_PACKAGE_luci-app-athena-led=m
# CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=m

# CONFIG_PACKAGE_nginx-full=n
CONFIG_PACKAGE_logrotate=y
# CONFIG_PACKAGE_luci-app-openlist2=n

# argon
CONFIG_PACKAGE_luci-theme-argon=y
# CONFIG_PACKAGE_luci-app-argon-config is not set
# CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn is not set
# n2n
CONFIG_PACKAGE_luci-app-n2n=y
CONFIG_PACKAGE_luci-i18n-n2n-zh-cn=y
# smb
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y
# aria2
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_ariang=y
CONFIG_PACKAGE_luci-i18n-aria2-zh-cn=y
# dfus
CONFIG_PACKAGE_dufs=y
CONFIG_PACKAGE_luci-app-dufs=y
CONFIG_PACKAGE_luci-i18n-dufs-zh-cn=y
# watchcat
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
# wol
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_wakeonlan=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
# clash
CONFIG_PACKAGE_luci-app-openclash=y
# python3
CONFIG_PACKAGE_python3=y


# 启用 ath11k 的 NSS 无线卸载支持
CONFIG_ATH11K_NSS_SUPPORT=y
# 启用 mac80211 的 NSS 支持
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
# 启用 WED (Wireless Ethernet Dispatch) 驱动
CONFIG_PACKAGE_kmod-qca-wed=y
# 为 NSS 设置中等内存配置文件 (适用于512MB设备)
CONFIG_NSS_MEM_PROFILE_MEDIUM=y
# 为 ath11k 设置512MB内存配置文件
CONFIG_ATH11K_MEM_PROFILE_512M=y


CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y
CONFIG_NSS_DRV_BRIDGE_ENABLE=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_PPPOE_ENABLE=y
CONFIG_PACKAGE_kmod-qca-mcs=y

# CONFIG_NSS_FIRMWARE_VERSION_11_4=n
# CONFIG_ATH11K_NSS_MESH_SUPPORT=n
